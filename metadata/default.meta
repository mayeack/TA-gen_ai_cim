#
# default.meta - Permissions and metadata
# TA-gen_ai_cim
#
# Updated: Added ServiceNow AI Case Management integration permissions
#

# Global settings
[]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

# Views (if any dashboards are added)
[views]
access = read : [ * ], write : [ admin, sc_admin, power ]
export = system

# Saved searches
[savedsearches]
access = read : [ * ], write : [ admin, sc_admin, power ]
export = system

# Lookups (if any are added)
[lookups]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

# Macros (if any are added)
[macros]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

# KV Store collections
[collections]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

# KV Store lookup transforms
[transforms/genai_token_cost_lookup]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

# Cisco Duo modular input checkpoint (v1.9.0): window positions only, no secret
# and no event content. Only the input reads and writes it, with its own session
# (splunk-system-user); the Duo Identity Feed derives lag from the indexed events
# and no lookup definition points at it. So: admin-only, and only in this app.
[collections/ta_gen_ai_cim_duo_checkpoint]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = none

###############################################################################
# SERVICENOW AI CASE MANAGEMENT INTEGRATION PERMISSIONS
###############################################################################

# ServiceNow case mapping KV Store lookup
[transforms/gen_ai_snow_case_map_lookup]
access = read : [ * ], write : [ admin, sc_admin, power ]
export = system

# ServiceNow case mapping KV Store collection
# Allow power users to create cases, admin to manage
[collections/gen_ai_snow_case_map]
access = read : [ * ], write : [ admin, sc_admin, power ]
export = system

# Custom search command - aicase
# Restricted to the same trusted roles as the open_case_in_servicenow workflow
# action and the gen_ai_snow_case_map collection (power users create cases,
# admins manage). Ordinary search users must not invoke | aicase directly: it
# fetches event content and creates external ServiceNow cases under the
# invoking user's session. Grant additional roles per-environment via local.meta.
[commands/aicase]
access = read : [ admin, sc_admin, power ], write : [ admin, sc_admin ]
export = system

# Custom search command - genaiseedes
# Seeds Mission Control (response plan, queue) and binds the
# plan's tasks to the simulated SOAR app through the ES pairing. It writes into
# the missioncontrol app's KV collections and reaches SOAR on the caller's
# behalf, so only admins may invoke it directly; the shipped scheduled search
# runs it under the system context.
[commands/genaiseedes]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = system

# ES integration settings (ta_gen_ai_cim_es.conf) - read only by | genaiseedes,
# whose command is admin-only and whose search is owner = admin (below).
# A conf's metadata object is named after the conf itself, the way splunkd
# writes [ta_gen_ai_cim_genai_scoring/pipeline_1] into local.meta. Up to
# v1.8.0 these ACLs sat under [conf/...] and [configs/conf-...], names Splunk
# never applies, so every one of the TA's confs inherited [] (read : [ * ],
# export = system); fixed in v1.9.0.
[ta_gen_ai_cim_es]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = none

# Workflow actions for Event Context menu
[workflow_actions]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

# Specific workflow action permissions
[workflow_actions/open_case_in_servicenow]
access = read : [ power, admin, sc_admin ], write : [ admin, sc_admin ]
export = system

# ServiceNow case redirect view
[views/servicenow_case]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

# Account configuration (ta_gen_ai_cim_account.conf): the ServiceNow, soar and
# (v1.9.0) Cisco Duo accounts - urls, usernames, OAuth client ids and Duo
# integration keys and API hostnames; secrets live only in [passwords] below.
# Every reader connects in this app's context as a role that passes: the
# ServiceNow sync and inventory alert actions (owner = admin searches, below),
# | genaiseedes (owner = admin), the Duo input (splunk-system-user), the
# Configuration page and the account REST handler (the caller's session;
# admins only), and | aicase / create_snow_aicase (the invoking user, who also
# needs [passwords] and list_storage_passwords, which power lacks by default).
# See [ta_gen_ai_cim_es] above for why the stanza is named after the conf.
[ta_gen_ai_cim_account]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = none

# REST endpoint for account management
[admin:ta_gen_ai_cim_account]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = none

[admin_external:ta_gen_ai_cim_account]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = none

# Credentials (storage/passwords) for every account in ta_gen_ai_cim_account.conf,
# realm ta_gen_ai_cim_account__<account>: ServiceNow passwords and OAuth client
# secrets, the soar token and (v1.9.0) the Cisco Duo secret key. Without this
# stanza they inherit [] (read : [ * ], export = system), so any role holding
# list_storage_passwords could read them from any app. Every reader connects in
# this app's context (owner nobody, app TA-gen_ai_cim) as a role that passes:
#   - sync_snow_asset / pull_snow_inventory alert actions: the alert's session,
#     and the shipped searches that run them are owner = admin (below);
#   - | aicase and an ad hoc create_snow_aicase: the invoking user (power holds
#     no list_storage_passwords, so it could never read them);
#   - | genaiseedes (the soar token): its search is owner = admin (below);
#   - the ta_gen_ai_cim_duo modular input: its own session, splunk-system-user,
#     whose splunk-system-role imports admin.
# Writers: the ta_gen_ai_cim_account REST handler and the Configuration page,
# both with an admin's session.
[passwords]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = none

###############################################################################
# AI GOVERNANCE REVIEW INTEGRATION PERMISSIONS
###############################################################################

# Review findings KV Store collection - ai_reviewers can write
[collections/gen_ai_review_findings]
access = read : [ * ], write : [ admin, sc_admin, ai_reviewers, power ]
export = system

# Review audit log KV Store collection
[collections/gen_ai_review_audit]
access = read : [ * ], write : [ admin, sc_admin, ai_reviewers ]
export = system

# Review findings lookup transform - ai_reviewers can write
[transforms/gen_ai_review_findings_lookup]
access = read : [ * ], write : [ admin, sc_admin, ai_reviewers ]
export = system

# Review audit lookup transform
[transforms/gen_ai_review_audit_lookup]
access = read : [ * ], write : [ admin, sc_admin, ai_reviewers ]
export = system

# Open AI Review workflow action - available to all users
[workflow_actions/1_open_ai_review]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

# Review Queue dashboard
[views/review_queue]
access = read : [ * ], write : [ admin, sc_admin, power ]
export = system

# Event Review form
[views/event_review]
access = read : [ * ], write : [ admin, sc_admin, power ]
export = system

# Navigation
[nav]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

# Authorization (ai_reviewers role)
[authorize]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

###############################################################################
# GENAI SCORING PIPELINE PERMISSIONS
###############################################################################

# GenAI scoring configuration (ta_gen_ai_cim_genai_scoring.conf) - read by the
# admin-only | genaiscore (admin-owned pipelines, below) and the admin-only
# genai_scoring_config view. Named after the conf: see [ta_gen_ai_cim_es].
[ta_gen_ai_cim_genai_scoring]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = none

# GenAI scoring configuration view
[views/genai_scoring_config]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = system

# GenAI scoring custom search command
# Admin-only: the command reads the admin-restricted
# ta_gen_ai_cim_genai_scoring.conf and sends event content to the configured
# LLM provider. The scoring pipelines that call it are admin-owned saved
# searches (see savedsearches stanzas below), so no non-admin path needs it.
[commands/genaiscore]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = system

# GenAI scoring pipeline saved searches must be owned by a real user (admin)
# so the scheduler runs them with a valid, authenticated session. The
# genaiscore command reads ta_gen_ai_cim_genai_scoring.conf over REST, and that
# conf is restricted to read:[admin]; a nobody-owned scheduled search fails
# config load with "Session is not logged in" and silently drops every event
# (genai_scoring_status=error gets filtered out). Owning as admin fixes it.
[savedsearches/GenAI%20Scoring%20-%20Pipeline%201]
owner = admin

[savedsearches/GenAI%20Scoring%20-%20Pipeline%202]
owner = admin

[savedsearches/GenAI%20Scoring%20-%20Pipeline%203]
owner = admin

[savedsearches/GenAI%20Scoring%20-%20Pipeline%204]
owner = admin

[savedsearches/GenAI%20Scoring%20-%20Pipeline%205]
owner = admin

[savedsearches/GenAI%20Scoring%20-%20Pipeline%206]
owner = admin

[savedsearches/GenAI%20Scoring%20-%20Pipeline%207]
owner = admin

[savedsearches/GenAI%20Scoring%20-%20Pipeline%208]
owner = admin

[savedsearches/GenAI%20Scoring%20-%20Pipeline%209]
owner = admin

[savedsearches/GenAI%20Scoring%20-%20Pipeline%2010]
owner = admin

# Same reason, and it matters more here because this one ships enabled with
# run_on_startup: the genaiseedes command is restricted to read:[admin,sc_admin]
# above, and it reads ta_gen_ai_cim_es.conf and writes the missioncontrol KV
# collections over REST. A nobody-owned scheduled search has no authenticated
# session for any of that, so the whole ES seeding step would silently no-op on
# a fresh install - exactly the install this search exists to serve.
[savedsearches/GenAI%20-%20ES%20-%20Seed%20Response%20Plan%20and%20SOAR%20Binding]
owner = admin

# The ServiceNow sync and inventory searches run the sync_snow_asset and
# pull_snow_inventory alert actions, which read the account conf and the
# account's credentials with the search's session; both are admin-only since
# v1.9.0 ([ta_gen_ai_cim_account] and [passwords] above). A nobody-owned search
# has no role that passes, so they are owned by admin like the scoring
# pipelines (R-CONF-005). All five ship disabled = 1.
[savedsearches/GenAI%20-%20ServiceNow%20Asset%20Sync]
owner = admin

[savedsearches/GenAI%20-%20ServiceNow%20Asset%20Re-Verify]
owner = admin

[savedsearches/GenAI%20-%20ServiceNow%20Model%20Sync]
owner = admin

[savedsearches/GenAI%20-%20ServiceNow%20Model%20Re-Verify]
owner = admin

[savedsearches/GenAI%20-%20ServiceNow%20Full%20Inventory%20Pull]
owner = admin

# GenAI - Identity - Duo Identity Lookup Gen (v1.9.0, ships disabled = 1)
# writes lookups/ta_gen_ai_cim_duo_identities.csv with outputlookup, and
# [lookups] write is admin, sc_admin, so it runs as admin (R-CONF-005), the way
# ES's own lookup-gen searches do.
[savedsearches/GenAI%20-%20Identity%20-%20Duo%20Identity%20Lookup%20Gen]
owner = admin

###############################################################################
# EVENTTYPE AND TAG PERMISSIONS
###############################################################################

[eventtypes]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[tags]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[datamodels]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

###############################################################################
# AI DEFENSE RESPONSE ACTION PERMISSIONS
#
# Simulated containment actions run by analysts from a finding or from a
# Containment task in the AI Incident Response Plan. Readable by all so the
# actions appear in the adaptive response menu; writable by admins only so
# analysts cannot retarget or reconfigure them.
###############################################################################

[alert_actions]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[alert_actions/ai_defense_suspend_user]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[alert_actions/ai_defense_revoke_session]
access = read : [ * ], write : [ admin, sc_admin ]
export = system

[alert_actions/ai_defense_tighten_guardrail]
access = read : [ * ], write : [ admin, sc_admin ]
export = system
