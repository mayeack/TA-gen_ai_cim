            "action": "test connectivity",
            "identifier": "test_connectivity",
            "description": "Validate the asset: sign a Duo Admin API read and look up the configured victim",
            "type": "test",
            "read_only": true,
            "parameters": {},
            "output": [],
            "versions": "EQ(*)"
        },
        {
            "action": "get user",
