            "parameters": {
                "username": {
                    "data_type": "string",
                    "required": true,
                    "primary": true,
                    "order": 0,
                    "contains": [
                        "user name",
                        "email"
                    ],
                    "description": "Username or email of a Lab 5 persona"
                }
            },
            "output": [
                {
                    "data_path": "action_result.parameter.username",
                    "data_type": "string",
                    "contains": [
                        "user name",
                        "email"
                    ]
                },
                {
                    "data_path": "action_result.data.*.username",
                    "data_type": "string",
                    "contains": [
