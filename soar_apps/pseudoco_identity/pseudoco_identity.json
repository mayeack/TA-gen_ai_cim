    "configuration": {
        "api_host": {
            "description": "Duo API hostname of the Lab 5 tenant (api-XXXXXXXX.duosecurity.com)",
            "data_type": "string",
            "required": true,
            "order": 0
        },
        "ikey": {
            "description": "Integration key of the Admin API application with Grant resource read + write",
            "data_type": "string",
            "required": true,
            "order": 1
        },
        "skey": {
            "description": "Secret key of that Admin API application",
            "data_type": "password",
            "required": true,
            "order": 2
        },
        "victim_username": {
            "description": "The room's victim persona - the only account disable user acts on",
            "data_type": "string",
            "required": true,
            "order": 3
        },
        "room": {
            "description": "Room label recorded on every result (e.g. the workshop and stack)",
            "data_type": "string",
            "required": false,
            "order": 4
        }
    },
    "actions": [
