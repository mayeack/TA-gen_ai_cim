    "app_version": "1.0.0",
    "utctime_updated": "2026-11-05T12:00:00.000000Z",
    "python_version": "3.9, 3.13",
    "min_phantom_version": "6.3.0",
    "fips_compliant": false,
    "logo": "logo_pseudoco_identity.svg",
    "logo_dark": "logo_pseudoco_identity_dark.svg",
